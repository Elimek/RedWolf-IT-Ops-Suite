# ============================================================
# RedWolf IT Officer Demo - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_ENV=dev
APP_DEBUG=false

# Web Server
WEB_PORT=80

# Database (MySQL 8.0)
DB_HOST=db
DB_PORT=3306
DB_NAME=redwolf
DB_USER=redwolf
DB_PASS=redwolf_secret
DB_ROOT_PASS=root_secret

# phpMyAdmin
PMA_PORT=8080

# Ollama (AI Service)
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b

# Currency (for Magento Lite)
CURRENCY_DEFAULT=HKD
USD_RATE=7.82
CNY_RATE=1.08

# Monitoring
METRICS_RETENTION_DAYS=7
ALERT_COOLDOWN_SECONDS=3600
CPU_THRESHOLD=90
MEMORY_THRESHOLD=85
DISK_THRESHOLD=90

# VPN Detection
VPN_CHECK_INTERVAL=60

# Admin (for protected endpoints)
ADMIN_USER=admin
ADMIN_PASS=changeme

# SMTP (for alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@redwolf-demo.local

# Webhook (optional)
WEBHOOK_URL=
